gdi:TouristenRoute a owl:Class ;
    rdfs:subClassOf gdi:Route ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gdi:Route [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty gdi:istTouristisch ] ) ] .

