                        rdfs:label "FormOfWay"@en .


###  http://inspire.ec.europa.eu/schemas/tn-ro/4.0/RoadLink
inspire-tn-ro:RoadLink rdf:type owl:Class ;
                       owl:equivalentClass gdi:Streckenabschnitt ;
                       rdfs:comment "A linear spatial object that describes the geometry and connectivity of a road network between two points in INSPIRE Road Transport Network."@en ;
                       rdfs:label "RoadLink"@en .


###  http://inspire.ec.europa.eu/schemas/tn-ro/4.0/RoadLinkSequence
inspire-tn-ro:RoadLinkSequence rdf:type owl:Class ;
                               owl:equivalentClass gdi:Route ;
                               rdfs:comment "A continuous path in a transport network without branches, particularly used to represent routes."@en ;
                               rdfs:label "RoadLinkSequence"@en .


###  http://inspire.ec.europa.eu/schemas/tn-ro/4.0/RoadNode
inspire-tn-ro:RoadNode rdf:type owl:Class ;
                       owl:equivalentClass gdi:Knoten ;
                       rdfs:comment "A point spatial object that is used to represent the connectivity between two or more road links, or the end of a road link in INSPIRE Road Transport Network."@en ;
                       rdfs:label "RoadNode"@en .


