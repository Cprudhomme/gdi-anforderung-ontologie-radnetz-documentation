@prefix : <https://registry.gdi-de.org/up3/ontology/> .
@prefix gdi: <https://registry.gdi-de.org/up3/ontology/> .
@prefix gml: <http://www.opengis.net/gml/3.2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix gml-exr: <http://www.opengis.net/gml/3.3/exr#> .
@prefix balm-code: <https://registry.gdi-de.org/codelist/de.bund.balm.radnetz/> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .
@prefix inspire-tn-ro: <http://inspire.ec.europa.eu/schemas/tn-ro/4.0/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://registry.gdi-de.org/up3/ontology/> .

<https://registry.gdi-de.org/up3/ontology/> rdf:type owl:Ontology ;
                                             dcterms:creator "Dr. Claire Ponciano" ;
                                             dc:creator "Dr. Claire Ponciano" ;
                                             dcterms:title "Radnetz Ontologie (GDI-DE)"@de ,
                                                           "Cycling Network Ontology (GDI-DE)"@en ;
                                             rdfs:comment "Harmonisierte und integrierte Ontologie für das Radnetz Deutschland (UP-3) und administrative Einheiten (Destatis GV2Q), bereinigt von GML/XSD-Artefakten und angebunden an BALM-Registry, GeoSPARQL und INSPIRE Road Transport Network."@de ,
                                                          "Harmonized and integrated ontology for the German Cycling Network (UP-3) and administrative units (Destatis GV2Q), cleaned of GML/XSD artifacts and aligned with BALM Registry, GeoSPARQL, and INSPIRE Road Transport Network."@en ;
                                             rdfs:label "Radnetz Ontologie v2"@de ,
                                                        "Cycling Network Ontology v2"@en ;
                                             owl:versionInfo "2.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.opengis.net/gml/3.2/description
gml:description rdf:type owl:AnnotationProperty .


###  http://www.opengis.net/gml/3.2/id
gml:id rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.opengis.net/ont/geosparql#wktLiteral
geosparql:wktLiteral rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://inspire.ec.europa.eu/schemas/tn-ro/4.0/centrelineGeometry
inspire-tn-ro:centrelineGeometry rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf inspire-tn-ro:geometry ;
                                 rdfs:range geosparql:Geometry ;
                                 rdfs:label "centrelineGeometry"@en .


###  http://inspire.ec.europa.eu/schemas/tn-ro/4.0/direction
inspire-tn-ro:direction rdf:type owl:ObjectProperty ;
                        rdfs:label "direction"@en .


###  http://inspire.ec.europa.eu/schemas/tn-ro/4.0/endNode
inspire-tn-ro:endNode rdf:type owl:ObjectProperty ;
                      owl:equivalentProperty gdi:endetBeiKnoten ;
                      rdfs:range inspire-tn-ro:RoadNode ;
                      rdfs:label "endNode"@en .


###  http://inspire.ec.europa.eu/schemas/tn-ro/4.0/formOfWay
inspire-tn-ro:formOfWay rdf:type owl:ObjectProperty ;
                        rdfs:label "formOfWay"@en .


###  http://inspire.ec.europa.eu/schemas/tn-ro/4.0/geometry
inspire-tn-ro:geometry rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf geosparql:hasGeometry ;
                       rdfs:range geosparql:Geometry ;
                       rdfs:label "geometry"@en .


###  http://inspire.ec.europa.eu/schemas/tn-ro/4.0/spokeEnd
inspire-tn-ro:spokeEnd rdf:type owl:ObjectProperty ;
                       owl:equivalentProperty gdi:ankommenderStreckenabschnitt ;
                       rdfs:range inspire-tn-ro:RoadLink ;
                       rdfs:label "spokeEnd"@en .


###  http://inspire.ec.europa.eu/schemas/tn-ro/4.0/spokeStart
inspire-tn-ro:spokeStart rdf:type owl:ObjectProperty ;
                         owl:equivalentProperty gdi:abgehenderStreckenabschnitt ;
                         rdfs:range inspire-tn-ro:RoadLink ;
                         rdfs:label "spokeStart"@en .


###  http://inspire.ec.europa.eu/schemas/tn-ro/4.0/startNode
inspire-tn-ro:startNode rdf:type owl:ObjectProperty ;
                        owl:equivalentProperty gdi:beginntBeiKnoten ;
                        rdfs:range inspire-tn-ro:RoadNode ;
                        rdfs:label "startNode"@en .


###  http://inspire.ec.europa.eu/schemas/tn-ro/4.0/surfaceCategory
inspire-tn-ro:surfaceCategory rdf:type owl:ObjectProperty ;
                              rdfs:label "surfaceCategory"@en .


###  http://www.opengis.net/ont/geosparql#hasGeometry
geosparql:hasGeometry rdf:type owl:ObjectProperty ;
                      rdfs:domain geosparql:Feature ;
                      rdfs:range geosparql:Geometry .


###  https://registry.gdi-de.org/up3/ontology/abgehenderStreckenabschnitt
gdi:abgehenderStreckenabschnitt rdf:type owl:ObjectProperty ;
                                owl:inverseOf gdi:beginntBeiKnoten ;
                                rdfs:domain gdi:Knoten ;
                                rdfs:range gdi:Streckenabschnitt ;
                                rdfs:label "abgehenderStreckenabschnitt"@de .


###  https://registry.gdi-de.org/up3/ontology/ankommenderStreckenabschnitt
gdi:ankommenderStreckenabschnitt rdf:type owl:ObjectProperty ;
                                 owl:inverseOf gdi:endetBeiKnoten ;
                                 rdfs:domain gdi:Knoten ;
                                 rdfs:range gdi:Streckenabschnitt ;
                                 rdfs:label "ankommenderStreckenabschnitt"@de .


###  https://registry.gdi-de.org/up3/ontology/baulast
gdi:baulast rdf:type owl:ObjectProperty ;
            rdfs:domain gdi:Streckenabschnitt ;
            rdfs:range balm-code:Baulast ;
            rdfs:comment "Zuständigkeit der Baulastträgerschaft (Unterhaltung)"@de ;
            rdfs:label "Baulast"@de .


###  https://registry.gdi-de.org/up3/ontology/befindetIn
gdi:befindetIn rdf:type owl:ObjectProperty ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( gdi:AdministrativeEbene
                                          gdi:AdministrativeType
                                        )
                          ] ;
               rdfs:comment "Räumliche oder administrative Zuordnung einer Entität zu einer Verwaltungseinheit"@de ;
               rdfs:label "befindet in"@de .


###  https://registry.gdi-de.org/up3/ontology/beginntBeiKnoten
gdi:beginntBeiKnoten rdf:type owl:ObjectProperty ;
                     rdfs:domain gdi:Streckenabschnitt ;
                     rdfs:range gdi:Knoten ;
                     rdfs:label "beginntBeiKnoten"@de .


###  https://registry.gdi-de.org/up3/ontology/belag
gdi:belag rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf inspire-tn-ro:surfaceCategory ;
          rdfs:domain gdi:Streckenabschnitt ;
          rdfs:range balm-code:Belag ;
          rdfs:comment "Art der Oberflaeche des Streckenabschnittes"@de ;
          rdfs:label "Belag"@de .


###  https://registry.gdi-de.org/up3/ontology/bewertung
gdi:bewertung rdf:type owl:ObjectProperty ;
              rdfs:domain gdi:Streckenabschnitt ;
              rdfs:range balm-code:Bewertung ;
              rdfs:comment "Bewertung des Zustandes der Oberflaechenbeschaffenheit"@de ;
              rdfs:label "Bewertung"@de .


###  https://registry.gdi-de.org/up3/ontology/breite_Klasse
gdi:breite_Klasse rdf:type owl:ObjectProperty ;
                  rdfs:domain gdi:Streckenabschnitt ;
                  rdfs:range balm-code:Breite_Klasse ;
                  rdfs:comment "Kategorie der Klassenbreite"@de ;
                  rdfs:label "Breite_Klasse"@de .


###  https://registry.gdi-de.org/up3/ontology/d-Route
gdi:d-Route rdf:type owl:ObjectProperty ;
            rdfs:domain gdi:Route ;
            rdfs:range balm-code:D-Route ;
            rdfs:comment "Zugehoerigkeit zu einer D-Route im Radnetz Deutschland"@de ;
            rdfs:label "D-Route"@de .


###  https://registry.gdi-de.org/up3/ontology/endetBeiKnoten
gdi:endetBeiKnoten rdf:type owl:ObjectProperty ;
                   rdfs:domain gdi:Streckenabschnitt ;
                   rdfs:range gdi:Knoten ;
                   rdfs:label "endetBeiKnoten"@de .


###  https://registry.gdi-de.org/up3/ontology/fuehrung
gdi:fuehrung rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf inspire-tn-ro:formOfWay ;
             rdfs:domain gdi:Streckenabschnitt ;
             rdfs:range balm-code:Fuehrung ;
             rdfs:comment "Angaben zur Fuehrungsform des Radverkehrs (ERA 2010)"@de ;
             rdfs:label "Fuehrung"@de .


###  https://registry.gdi-de.org/up3/ontology/gehoertZu
gdi:gehoertZu rdf:type owl:ObjectProperty ;
              rdfs:domain gdi:AdministrativeEbene ;
              rdfs:range gdi:AdministrativeEbene ;
              rdfs:label "gehört zu (übergeordnete Verwaltungseinheit)"@de .


###  https://registry.gdi-de.org/up3/ontology/geometrieAbschnitt
gdi:geometrieAbschnitt rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf inspire-tn-ro:centrelineGeometry ,
                                          geosparql:hasGeometry ;
                       rdfs:domain gdi:Streckenabschnitt ;
                       rdfs:range geosparql:Geometry ;
                       rdfs:comment "Lineare Geometrie des Streckenabschnittes (Mittellinie)"@de ;
                       rdfs:label "GeometrieAbschnitt"@de .


###  https://registry.gdi-de.org/up3/ontology/geometrieKnoten
gdi:geometrieKnoten rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf inspire-tn-ro:geometry ,
                                       geosparql:hasGeometry ;
                    rdfs:domain gdi:Knoten ;
                    rdfs:range geosparql:Geometry ;
                    rdfs:comment "Punktgeometrie des Netzknotens"@de ;
                    rdfs:label "GeometrieKnoten"@de .


###  https://registry.gdi-de.org/up3/ontology/hasKnoten
gdi:hasKnoten rdf:type owl:ObjectProperty ;
              rdfs:range gdi:Knoten ;
              rdfs:label "hasKnoten"@de .


###  https://registry.gdi-de.org/up3/ontology/hasRoute
gdi:hasRoute rdf:type owl:ObjectProperty ;
             owl:inverseOf gdi:hasStreckenabschnitt ;
             rdfs:domain gdi:Streckenabschnitt ;
             rdfs:range gdi:Route ;
             rdfs:label "hasRoute"@de .


###  https://registry.gdi-de.org/up3/ontology/hasStreckenabschnitt
gdi:hasStreckenabschnitt rdf:type owl:ObjectProperty ;
                         rdfs:domain gdi:Route ;
                         rdfs:range gdi:Streckenabschnitt ;
                         rdfs:label "hasStreckenabschnitt"@de .


###  https://registry.gdi-de.org/up3/ontology/hasWegweisung
gdi:hasWegweisung rdf:type owl:ObjectProperty ;
                  rdfs:domain gdi:Knoten ;
                  rdfs:range gdi:Wegweisung ;
                  rdfs:label "hasWegweisung"@de .


###  https://registry.gdi-de.org/up3/ontology/hatGradDerVerstaedterung
gdi:hatGradDerVerstaedterung rdf:type owl:ObjectProperty ;
                             rdfs:domain gdi:Gemeinde ;
                             rdfs:range gdi:GradDerVerstaedterung ;
                             rdfs:label "hat Grad der Verstädterung"@de .


###  https://registry.gdi-de.org/up3/ontology/kommuNetz
gdi:kommuNetz rdf:type owl:ObjectProperty ;
              rdfs:domain gdi:Route ;
              rdfs:range balm-code:KommuNetz .


###  https://registry.gdi-de.org/up3/ontology/licht
gdi:licht rdf:type owl:ObjectProperty ;
          rdfs:domain gdi:Streckenabschnitt ;
          rdfs:range balm-code:Licht ;
          rdfs:comment "Beleuchtung der Radverkehrsanlage"@de ;
          rdfs:label "Licht"@de .


###  https://registry.gdi-de.org/up3/ontology/liegtInReisegebiet
gdi:liegtInReisegebiet rdf:type owl:ObjectProperty ;
                       rdfs:domain gdi:AdministrativeEbene ;
                       rdfs:range gdi:Reisegebiet ;
                       rdfs:label "liegt in Reisegebiet"@de .


###  https://registry.gdi-de.org/up3/ontology/orslage
gdi:orslage rdf:type owl:ObjectProperty ;
            rdfs:domain gdi:Streckenabschnitt ;
            rdfs:range balm-code:Ortslage ;
            rdfs:comment "Beschreibung der Ortslage (innerorts / ausserorts)"@de ;
            rdfs:label "Ortslage"@de .


###  https://registry.gdi-de.org/up3/ontology/richtung
gdi:richtung rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf inspire-tn-ro:direction ;
             rdfs:domain gdi:Streckenabschnitt ;
             rdfs:range balm-code:Richtung ;
             rdfs:comment "Fahrtrichtung der Befahrbarkeit des Streckenabschnittes"@de ;
             rdfs:label "Richtung"@de .


###  https://registry.gdi-de.org/up3/ontology/status
gdi:status rdf:type owl:ObjectProperty ;
           rdfs:domain gdi:Streckenabschnitt ;
           rdfs:range balm-code:Status ;
           rdfs:comment "Befahrbarkeitsstatus des Streckenabschnittes"@de ;
           rdfs:label "Status"@de .


#################################################################
#    Data properties
#################################################################

###  http://inspire.ec.europa.eu/schemas/tn-ro/4.0/beginLifespanVersion
inspire-tn-ro:beginLifespanVersion rdf:type owl:DatatypeProperty ;
                                   owl:equivalentProperty gdi:lebenszeitintervallAnfang ;
                                   rdfs:range xsd:dateTime ;
                                   rdfs:label "beginLifespanVersion"@en .


###  http://inspire.ec.europa.eu/schemas/tn-ro/4.0/endLifespanVersion
inspire-tn-ro:endLifespanVersion rdf:type owl:DatatypeProperty ;
                                 owl:equivalentProperty gdi:lebenszeitintervallEnde ;
                                 rdfs:range xsd:dateTime ;
                                 rdfs:label "endLifespanVersion"@en .


###  http://inspire.ec.europa.eu/schemas/tn-ro/4.0/roadWidthValue
inspire-tn-ro:roadWidthValue rdf:type owl:DatatypeProperty ;
                             rdfs:range xsd:integer ;
                             rdfs:label "roadWidthValue"@en .


###  http://inspire.ec.europa.eu/schemas/tn-ro/4.0/speedLimitValue
inspire-tn-ro:speedLimitValue rdf:type owl:DatatypeProperty ;
                              rdfs:range xsd:int ;
                              rdfs:label "speedLimitValue"@en .


###  http://www.opengis.net/ont/geosparql#asWKT
geosparql:asWKT rdf:type owl:DatatypeProperty ;
                rdfs:domain geosparql:Geometry ;
                rdfs:range geosparql:wktLiteral .


###  https://registry.gdi-de.org/up3/ontology/b-Pflicht
gdi:b-Pflicht rdf:type owl:DatatypeProperty ;
              rdfs:domain gdi:Streckenabschnitt ;
              rdfs:range xsd:boolean ;
              rdfs:label "B-Pflicht"@de ,
                         "Benutzungspflicht"@de .


###  https://registry.gdi-de.org/up3/ontology/baulast_3
gdi:baulast_3 rdf:type owl:DatatypeProperty ;
              rdfs:domain gdi:Streckenabschnitt ;
              rdfs:range xsd:string ;
              rdfs:comment "Freitext-Zustaendigkeit Dritte"@de ;
              rdfs:label "Baulast_3"@de .


###  https://registry.gdi-de.org/up3/ontology/bevoelkerungInsgesamt
gdi:bevoelkerungInsgesamt rdf:type owl:DatatypeProperty ;
                          rdfs:domain gdi:AdministrativeEbene ;
                          rdfs:range xsd:integer ;
                          rdfs:label "Bevölkerung Insgesamt"@de .


###  https://registry.gdi-de.org/up3/ontology/bevoelkerungJeKm2
gdi:bevoelkerungJeKm2 rdf:type owl:DatatypeProperty ;
                      rdfs:domain gdi:AdministrativeEbene ;
                      rdfs:range xsd:integer ;
                      rdfs:label "Bevölkerung je km²"@de .


###  https://registry.gdi-de.org/up3/ontology/bevoelkerungMaennlich
gdi:bevoelkerungMaennlich rdf:type owl:DatatypeProperty ;
                          rdfs:domain gdi:AdministrativeEbene ;
                          rdfs:range xsd:integer ;
                          rdfs:label "Bevölkerung Männlich"@de .


###  https://registry.gdi-de.org/up3/ontology/bevoelkerungWeiblich
gdi:bevoelkerungWeiblich rdf:type owl:DatatypeProperty ;
                         rdfs:domain gdi:AdministrativeEbene ;
                         rdfs:range xsd:integer ;
                         rdfs:label "Bevölkerung Weiblich"@de .


###  https://registry.gdi-de.org/up3/ontology/bewert_1
gdi:bewert_1 rdf:type owl:DatatypeProperty ;
             rdfs:domain gdi:Streckenabschnitt ;
             rdfs:range xsd:date ;
             rdfs:comment "Datum der Zustandsbewertung"@de ;
             rdfs:label "Bewert_1"@de .


###  https://registry.gdi-de.org/up3/ontology/breite
gdi:breite rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf inspire-tn-ro:roadWidthValue ;
           rdfs:domain gdi:Streckenabschnitt ;
           rdfs:range xsd:integer ;
           rdfs:comment "Ausmasse der erfassten Mindestbreite eines Abschnittes in Zentimetern"@de ;
           rdfs:label "Breite"@de .


###  https://registry.gdi-de.org/up3/ontology/breitengrad
gdi:breitengrad rdf:type owl:DatatypeProperty ;
                rdfs:domain gdi:Gemeinde ;
                rdfs:range xsd:double ;
                rdfs:label "Geografischer Mittelpunkt Breitengrad"@de .


###  https://registry.gdi-de.org/up3/ontology/bundesnetz
gdi:bundesnetz rdf:type owl:DatatypeProperty ;
               rdfs:domain gdi:Streckenabschnitt ;
               rdfs:range xsd:string ;
               rdfs:comment "Zugehoerigkeit zu einem Bundesnetz (Bundesstrasse oder Bundesautobahn)"@de ;
               rdfs:label "Bundesnetz"@de .


###  https://registry.gdi-de.org/up3/ontology/datum
gdi:datum rdf:type owl:DatatypeProperty ;
          rdfs:domain gdi:Knoten ,
                      gdi:Streckenabschnitt ;
          rdfs:range xsd:date ;
          rdfs:comment "Systemdatum der letzten Aenderung"@de ;
          rdfs:label "Datum"@de .


###  https://registry.gdi-de.org/up3/ontology/ergNetze
gdi:ergNetze rdf:type owl:DatatypeProperty ;
             rdfs:domain gdi:Route ;
             rdfs:range xsd:string ;
             rdfs:comment "Weitere relevante Ergaenzungsnetze"@de ;
             rdfs:label "ergNetze"@de .


###  https://registry.gdi-de.org/up3/ontology/euroVelo
gdi:euroVelo rdf:type owl:DatatypeProperty ;
             rdfs:domain gdi:Route ;
             rdfs:range xsd:boolean ;
             rdfs:comment "Zugehoerigkeit zum europaeischen EuroVelo-Netz"@de ;
             rdfs:label "EuroVelo"@de .


###  https://registry.gdi-de.org/up3/ontology/flaeche
gdi:flaeche rdf:type owl:DatatypeProperty ;
            rdfs:domain gdi:AdministrativeEbene ;
            rdfs:range xsd:double ;
            rdfs:label "Fläche in km²"@de .


###  https://registry.gdi-de.org/up3/ontology/gemeindenanzahl
gdi:gemeindenanzahl rdf:type owl:DatatypeProperty ;
                    rdfs:domain gdi:AdministrativeEbene ;
                    rdfs:range xsd:integer ;
                    rdfs:label "Gemeindenanzahl"@de .


###  https://registry.gdi-de.org/up3/ontology/hoehe
gdi:hoehe rdf:type owl:DatatypeProperty ;
          rdfs:domain gdi:Knoten ;
          rdfs:range xsd:double ;
          rdfs:comment "Hoehe in Metern ueber dem Meeresspiegel"@de ;
          rdfs:label "Hoehe"@de .


###  https://registry.gdi-de.org/up3/ontology/istTouristisch
gdi:istTouristisch rdf:type owl:DatatypeProperty ;
                   rdfs:domain gdi:Route ;
                   rdfs:range xsd:boolean ;
                   rdfs:label "istTouristisch"@de .


###  https://registry.gdi-de.org/up3/ontology/knoten-ID
gdi:knoten-ID rdf:type owl:DatatypeProperty ;
              rdfs:domain gdi:Knoten ;
              rdfs:range xsd:string ;
              rdfs:comment "Eindeutiger Primaerschluessel des Knotens"@de ;
              rdfs:label "Knoten-ID"@de .


###  https://registry.gdi-de.org/up3/ontology/knotennetz-ID
gdi:knotennetz-ID rdf:type owl:DatatypeProperty ;
                  rdfs:domain gdi:Wegweisung ;
                  rdfs:range xsd:string ;
                  rdfs:label "Knotennetz-ID"@de .


###  https://registry.gdi-de.org/up3/ontology/kommuNetz
gdi:kommuNetz rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string .


###  https://registry.gdi-de.org/up3/ontology/laenge
gdi:laenge rdf:type owl:DatatypeProperty ;
           rdfs:domain gdi:Streckenabschnitt ;
           rdfs:range xsd:integer ;
           rdfs:comment "Laenge des Streckenabschnittes in Metern"@de ;
           rdfs:label "Laenge"@de .


###  https://registry.gdi-de.org/up3/ontology/laengengrad
gdi:laengengrad rdf:type owl:DatatypeProperty ;
                rdfs:domain gdi:Gemeinde ;
                rdfs:range xsd:double ;
                rdfs:label "Geografischer Mittelpunkt Längengrad"@de .


###  https://registry.gdi-de.org/up3/ontology/landesnetz
gdi:landesnetz rdf:type owl:DatatypeProperty ;
               rdfs:comment "Zugehoerigkeit zum Landesradnetz oder Landesstrassennetz"@de ;
               rdfs:label "Landesnetz"@de .


###  https://registry.gdi-de.org/up3/ontology/lebenszeitintervallAnfang
gdi:lebenszeitintervallAnfang rdf:type owl:DatatypeProperty ;
                              rdfs:domain gdi:Knoten ,
                                          gdi:Route ,
                                          gdi:Streckenabschnitt ,
                                          gdi:Wegweisung ;
                              rdfs:range xsd:dateTime ;
                              rdfs:label "lebenszeitintervallAnfang"@de .


###  https://registry.gdi-de.org/up3/ontology/lebenszeitintervallEnde
gdi:lebenszeitintervallEnde rdf:type owl:DatatypeProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain gdi:Knoten ,
                                        gdi:Route ,
                                        gdi:Streckenabschnitt ,
                                        gdi:Wegweisung ;
                            rdfs:range xsd:dateTime ;
                            rdfs:label "lebenszeitintervallEnde"@de .


###  https://registry.gdi-de.org/up3/ontology/name
gdi:name rdf:type owl:DatatypeProperty ;
         rdfs:domain gdi:Route ;
         rdfs:range xsd:string ;
         rdfs:comment "Klarname der Route"@de ;
         rdfs:label "Name"@de .


###  https://registry.gdi-de.org/up3/ontology/postleitzahl
gdi:postleitzahl rdf:type owl:DatatypeProperty ;
                 rdfs:domain gdi:Gemeinde ;
                 rdfs:range xsd:string ;
                 rdfs:label "Postleitzahl"@de .


###  https://registry.gdi-de.org/up3/ontology/quell-ID
gdi:quell-ID rdf:type owl:DatatypeProperty ;
             rdfs:domain gdi:Knoten ,
                         gdi:Streckenabschnitt ;
             rdfs:range xsd:string ;
             rdfs:comment "Urspruengliche ID aus der Quelldatenbank"@de ;
             rdfs:label "Quell-ID"@de .


