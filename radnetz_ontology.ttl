gdi:Streckenabschnitt a owl:Class ;
    rdfs:subClassOf gml:AbstractFeature,
        gdi:StreckenabschnittType ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty gdi:hasRoute ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty gdi:beginntBeiKnoten ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty gdi:endetBeiKnoten ] .

