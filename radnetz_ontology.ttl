###  https://registry.gdi-de.org/up3/ontology/Streckenabschnitt
gdi:Streckenabschnitt rdf:type owl:Class ;
                      rdfs:subClassOf geosparql:Feature ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty gdi:beginntBeiKnoten ;
                                        owl:cardinality "1"^^xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty gdi:endetBeiKnoten ;
                                        owl:cardinality "1"^^xsd:nonNegativeInteger
                                      ] ;
                      rdfs:comment "Ein Teilstueck einer Route mit einheitlichen deskriptiven Attributen (GM_Curve), verbindet die Knoten."@de ;
                      rdfs:label "Streckenabschnitt"@de .


###  https://registry.gdi-de.org/up3/ontology/TouristenRoute
gdi:TouristenRoute rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( gdi:Route
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty gdi:istTouristisch ;
                                                                owl:hasValue "true"^^xsd:boolean
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf gdi:Route ;
                   rdfs:comment "Touristische Radroute, abgeleitet durch die Eigenschaft istTouristisch."@de ;
                   rdfs:label "TouristenRoute"@de .


