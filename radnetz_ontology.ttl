gml:curvePropertyType a owl:ObjectProperty ;
    rdfs:label "CurvePropertyType" .

gml:description a owl:AnnotationProperty .

gml:id a owl:AnnotationProperty .

gml:pointPropertyType a owl:ObjectProperty ;
    rdfs:label "PointPropertyType" .

geosparql:Geometry a owl:Class ;
    rdfs:subClassOf geosparql:SpatialObject .

geosparql:asWKT a owl:DatatypeProperty .

geosparql:hasGeometry a owl:ObjectProperty .

